# Environment variable NAMES required by this project. Values go in your
# local environment or a git-ignored .env — never in any config file.

# API key for the 'anthropic' provider (referenced by
# profiles/system/dev.yaml -> providers.anthropic.api_key_env)
ANTHROPIC_API_KEY=

# Selects which system config to load: profiles/system/{APP_ENV}.yaml
# One of: dev, staging, prod. Defaults to dev.
APP_ENV=dev
